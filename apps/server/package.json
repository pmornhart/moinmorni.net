{
  "name": "@moinmorni/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "MoinMorni: Webseite-API, Panel-API, Hub für die Plugins, Anbindung an den Motor (MorniHosting)",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup src/index.ts src/cli.ts --format esm --target node22 --clean --sourcemap",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "@fastify/http-proxy": "^11.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.2.0",
    "@moinmorni/shared": "workspace:*",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.6.1",
    "fastify-type-provider-zod": "^6.1.0",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  }
}
