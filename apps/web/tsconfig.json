{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "paths": {
      "~/*": ["./src/*"],
      "@/i18n": ["./src/i18n/index.ts"],
      "@/*": ["../../vendor/mornihosting/apps/web/src/*"],
      "@mornihosting/shared": ["../../vendor/mornihosting/packages/shared/src/index.ts"],
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom/index.d.ts"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "react-router": ["./node_modules/react-router"],
      "@tanstack/react-query": ["./node_modules/@tanstack/react-query"],
      "i18next": ["./node_modules/i18next"],
      "react-i18next": ["./node_modules/react-i18next"],
      "sonner": ["./node_modules/sonner"],
      "radix-ui": ["./node_modules/radix-ui"],
      "lucide-react": ["./node_modules/lucide-react"],
      "@simplewebauthn/browser": ["./node_modules/@simplewebauthn/browser"]
    }
  },
  "include": ["src", "vite.config.ts", "../../vendor/mornihosting/apps/web/src/demo-images.d.ts"]
}
