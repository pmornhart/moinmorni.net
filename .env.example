# MoinMorni – Einstellungen (install.sh legt die echte .env an, nur für root lesbar). Nie ins Repo!

# Öffentliche Adresse des Netzwerks
MM_DOMAIN=moinmorni.net
# Port der Webseite auf diesem Rechner (NetBird leitet HTTPS hierher)
MM_PORT=8080
# IP dieses Rechners im Heimnetz (zeigt das Panel als Adresse für zu Hause)
MM_LAN_IP=

# Geheimnisse – install.sh erzeugt sie zufällig
MM_SECRET=
MH_SECRET=
# Schlüssel, mit dem MoinMorni den Motor steuert (install.sh: `service-token moinmorni`)
MM_MOTOR_TOKEN=

# Discord-Bot (optional, lässt sich auch im Panel eintragen)
MM_DISCORD_TOKEN=
# Für „Mit Discord anmelden“ beim Bewerben für MorniCraft (Developer Portal → OAuth2 → Client Secret)
MM_DISCORD_CLIENT_SECRET=

# NetBird-Server dieses Rechners – install.sh und update.sh tragen ihn selbst ein (aus „netbird status“)
MH_NETBIRD_API=

# Branch, dem die Updates im Panel folgen – install.sh und update.sh tragen den installierten ein (leer = main)
MM_UPDATE_BRANCH=

TZ=Europe/Berlin
